ribuição do Projeto de Resolução n.º 172/XVII/1.ª (CH) - «Recomenda ao Governo o reforço da luta fitossanitária e a criação de apoios específicos para os produtores afetados pela vespa-do-galho-do-castanheiro» à Comissão de Agricultura e Pescas, uma vez que o respetivo objeto se enquadra mais diretamente no âmbito de competências desta Comissão. Assim, em reapreciação da distribuição efetuada, remeta-se à Comissão de Agricultura e Pescas com conhecimento à Comissão de Ambiente e Energia e à DSAP.\"","votes":[],"publication":null},{"phase":"Votação Deliberação","date":"2026-04-30","note":null,"votes":[{"id":"171635","date":"2026-04-30","result":"Aprovado","unanimous":false,"description":null,"parties":{"favor":["PSD","CH","PS","IL","CDS-PP","BE","JPP"],"contra":[],"abstencao":["L","PCP","PAN"],"partial":[],"deputies":[]},"absences":null}],"publication":{"type":"DAR I série","url":"https://debates.parlamento.pt/catalogo/r3/dar/01/17/01/086/2026-05-02/47?pgs=47&org=PLC"}},{"phase":"Envio à Comissão para fixação da Redação final","date":"2026-05-08","note":null,"votes":[],"publication":null},{"phase":"Envio INCM","date":"2026-05-22","note":null,"votes":[],"publication":null},{"phase":"Resolução (Publicação DAR)","date":"2026-05-22","note":null,"votes":[],"publication":null},{"phase":"Resolução da AR (Publicação DR)","date":"2026-05-27","note":null,"votes":[],"publication":null}],"jointInitiatives":[],"origin":[],"originated":[],"petitions":[],"citedActs":[],"publishedAs":[{"type":"Resolução da Assembleia da República","number":"133","year":"2026","publishedOn":"2026-05-27","drUrl":"http://data.dre.pt/eli/diario/1/102/2026/0/pt/html"}]}