{"id":"356268","number":"11","type":"Apreciação Parlamentar","typeCode":"A","title":"Decreto-Lei n.º 52/2026, de 16 de fevereiro, que “Altera o Decreto-Lei n.º 171/2001, de 25 de maio, que constituiu a sociedade Águas de Santo André, S. A., e à qual atribuiu a concessão da exploração e da gestão do sistema de abasteci-mento de água, de saneamento e de resíduos sólidos de Santo André, clarificando o estatuto de operador único e determinando a atribuição dos títulos de utilização do domínio hídrico inerentes à concessão das atividades prosseguidas.”","authors":[{"kind":"grupo","name":"CH","party":"CH"},{"kind":"outro","name":"Grupos Parlamentares"}],"authorParties":["CH"],"enteredOn":"2026-03-03","lastPhase":"Admissão","lastDate":"2026-03-09","status":"em-curso","statusPhase":null,"statusDate":null,"decrees":[],"stage":null,"legislature":"XVII","session":"1","textUrl":"http://app.parlamento.pt/webutils/docs/doc.pdf?path=6148523063484d364c793968636d356c6443397a6158526c63793959566b6c4a5447566e4c305276593356745a57353062334e4a626d6c6a6157463061585a684c324d314e4449344e7a64694c5463354e6d49744e446c685a5330344f5463344c574d354f54686c59544e694f474e685a69356b62324e34&fich=c542877b-796b-49ae-8978-c998ea3b8caf.docx&Inline=true","officialUrl":"https://www.parlamento.pt/ActividadeParlamentar/Paginas/DetalheIniciativa.aspx?BID=356268","events":[{"phase":"Entrada","date":"2026-03-03","note":null,"votes":[],"publication":null},{"phase":"Anúncio","date":"2026-03-05","note":null,"votes":[],"publication":null},{"phase":"Admissão","date":"2026-03-09","note":null,"votes":[],"publication":null}],"jointInitiatives":[],"origin":[],"originated":[],"petitions":[],"citedActs":["Decreto-Lei n.º 52/2026","Decreto-Lei n.º 171/2001"],"publishedAs":[]}